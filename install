#!/usr/bin/env bash
# Independent zsh, tmux, Neovim, and mpv configuration installer for macOS and Linux.
set -euo pipefail

script_dir=$(cd -P "$(dirname "$0")" && pwd)
if [[ -f "$script_dir/tmux/tmux.conf" && -d "$script_dir/nvim" ]]; then
  repo_dir="$script_dir"
else
  repo_dir="${DOTFILES_REPO_DIR:-$HOME/.local/share/dotfiles}"
fi

action=install
component=all
yes=false
dry_run=false
config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
data_root="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles"
nvim_marker="$config_root/nvim/.dotfiles-nvim-managed"
tmux_marker="$config_root/tmux/.dotfiles-tmux-managed"
zsh_marker="$config_root/zsh/.dotfiles-zsh-managed"
mpv_marker="$config_root/mpv/.dotfiles-mpv-managed"
course_marker="$config_root/.dotfiles-course-managed"
tmux_files=(tmux.conf resource-status.sh git-status.sh program-name.sh codex-status.sh easy-motion-default.sh resource-monitor.sh)
btop_files=(btop.conf)
zsh_files=(path-navigation.zsh)

nvim_files=(init.lua nvim-pack-lock.json lua/options.lua lua/plugins.lua lua/lsp.lua lua/keymaps.lua lua/vimzap/tasks.lua lua/vimzap/projects.lua lua/vimzap/debug.lua lua/vimzap/dashboard.lua lsp/ts_ls.lua lsp/html.lua lsp/cssls.lua lsp/jsonls.lua lsp/tailwindcss.lua lsp/eslint.lua lsp/lua_ls.lua lsp/pyright.lua lsp/gopls.lua lsp/clangd.lua lsp/rust_analyzer.lua)

usage() {
  cat <<'EOF'
  dotfiles — independent zsh, tmux, btop, Neovim, mpv, and course launcher configuration

Usage:
  dotfiles [install|update|uninstall] [zsh|tmux|btop|nvim|mpv|course] [--yes] [--dry-run]

Actions:
  install       Install all configured components (default)
  update        Pull the checkout and reinstall the selected component
  uninstall     Remove only managed files (with a backup)

Options:
  -y, --yes     Skip confirmation prompts
  --dry-run     Show actions without changing files or installing packages
  -h, --help    Show this help
EOF
}

die() { echo "Error: $*" >&2; exit 1; }
confirm() {
  [[ "$yes" == true || "$dry_run" == true ]] && return 0
  read -r -p "  $1 (y/N) " answer
  [[ "$answer" =~ ^[Yy]$ ]]
}
selected() { [[ "$component" == all || "$component" == "$1" ]]; }

zshrc_source_block() {
  cat <<'EOF'
# >>> dotfiles zsh >>>
source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/path-navigation.zsh"
# <<< dotfiles zsh <<<
EOF
}

install_packages() {
  local os="$1"; local -a packages=()
  if [[ "$(printenv DOTFILES_SKIP_PACKAGES || true)" == true ]]; then
    echo "  Skipping OS package installation (DOTFILES_SKIP_PACKAGES=true)"
    return
  fi
  if selected tmux; then
    command -v tmux >/dev/null 2>&1 || packages+=(tmux)
    command -v lazygit >/dev/null 2>&1 || packages+=(lazygit)
    command -v git >/dev/null 2>&1 || packages+=(git)
    if [[ "$os" == Darwin ]]; then
      command -v python >/dev/null 2>&1 || packages+=(python)
    else
      command -v python >/dev/null 2>&1 || packages+=(python3)
    fi
  fi
  if selected tmux || selected btop; then
    command -v btop >/dev/null 2>&1 || packages+=(btop)
  fi
  if selected nvim; then
    command -v nvim >/dev/null 2>&1 || packages+=(neovim)
    command -v git >/dev/null 2>&1 || packages+=(git)
    command -v node >/dev/null 2>&1 || packages+=(node)
    command -v npm >/dev/null 2>&1 || packages+=(npm)
    command -v rg >/dev/null 2>&1 || packages+=(ripgrep)
    command -v lua-language-server >/dev/null 2>&1 || packages+=(lua-language-server)
    command -v pyright-langserver >/dev/null 2>&1 || packages+=(pyright)
    command -v gopls >/dev/null 2>&1 || packages+=(gopls)
    if ! command -v clangd >/dev/null 2>&1; then
      [[ "$os" == Darwin ]] && packages+=(llvm) || packages+=(clangd)
    fi
    command -v rust-analyzer >/dev/null 2>&1 || packages+=(rust-analyzer)
  fi
  if selected mpv; then
    command -v mpv >/dev/null 2>&1 || packages+=(mpv)
  fi
  if selected course; then
    command -v mpv >/dev/null 2>&1 || packages+=(mpv)
  fi
  [[ "$dry_run" == true ]] && { echo "  Would install packages: ${packages[*]:-none}"; return; }
  ((${#packages[@]} == 0)) && return
  if [[ "$os" == Darwin ]]; then
    command -v brew >/dev/null 2>&1 || die "Homebrew is required to install missing tools: https://brew.sh"
    brew install "${packages[@]}"
  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update -qq && sudo apt-get install -y "${packages[@]}"
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y "${packages[@]}"
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -Sy --noconfirm "${packages[@]}"
  else
    die "No supported package manager found; install manually: ${packages[*]}"
  fi
}

install_zsh() {
  selected zsh || return 0
  [[ -f "$repo_dir/zsh/path-navigation.zsh" ]] || die "Invalid zsh component in checkout"
  local dest="$config_root/zsh" zshrc="$HOME/.zshrc" backup="$HOME/.zshrc.backup.$(date +%s)"
  if [[ "$dry_run" == true ]]; then
    echo "  Would install zsh configuration into $dest"
    echo "  Would add the managed source block to $zshrc"
    return
  fi
  mkdir -p "$dest"
  copy_file "$repo_dir/zsh/path-navigation.zsh" "$dest/path-navigation.zsh" "$dest/path-navigation.zsh.backup.$(date +%s)"
  if [[ -f "$zshrc" ]]; then cp -p "$zshrc" "$backup"; fi
  if ! grep -q '^# >>> dotfiles zsh >>>$' "$zshrc" 2>/dev/null; then
    { [[ -s "$zshrc" ]] && printf '\n'; zshrc_source_block; } >> "$zshrc"
  fi
  printf 'dotfiles manages zsh/path-navigation.zsh and its source block in ~/.zshrc.\n' > "$zsh_marker"
  echo "  zsh configuration installed (backup: $backup)"
}

merge_mpv_config() {
  local source="$repo_dir/mpv/mpv.conf" dest="$config_root/mpv/mpv.conf" backup="$1"
  if [[ ! -f "$dest" ]]; then
    cp -p "$source" "$dest"
    return
  fi
  mkdir -p "$(dirname "$backup")"
  cp -p "$dest" "$backup"
  while IFS= read -r option; do
    [[ -z "$option" || "$option" == \#* ]] && continue
    grep -Eq "^${option%%=*}(=|$)" "$dest" || printf '%s\n' "$option" >> "$dest"
  done < "$source"
}

install_mpv() {
  selected mpv || return 0
  [[ -f "$repo_dir/mpv/mpv.conf" ]] || die "Invalid mpv component in checkout"
  local mpv_dest="$config_root/mpv"
  local backup="$config_root/mpv.backup.$(date +%s)"
  if [[ "$dry_run" == true ]]; then echo "  Would install mpv configuration into $mpv_dest"; return; fi
  mkdir -p "$mpv_dest"
  merge_mpv_config "$backup/mpv.conf"
  copy_file "$repo_dir/bin/mpv" "$HOME/.local/bin/mpv" "$backup/mpv"
  chmod +x "$HOME/.local/bin/mpv"
  printf 'dotfiles manages mpv/mpv.conf.\n' > "$mpv_marker"
  echo "  mpv configuration installed (backup: $backup)"
}

install_course() {
  selected course || return 0
  [[ -f "$repo_dir/bin/course" ]] || die "Invalid course component in checkout"
  local backup="$HOME/.local/bin/course.backup.$(date +%s)"
  if [[ "$dry_run" == true ]]; then echo "  Would install course launcher into $HOME/.local/bin"; return; fi
  copy_file "$repo_dir/bin/course" "$HOME/.local/bin/course" "$backup"
  chmod +x "$HOME/.local/bin/course"
  printf 'dotfiles manages ~/.local/bin/course.\n' > "$course_marker"
  echo "  course launcher installed (backup: $backup)"
}

install_language_servers() {
  selected nvim || return 0
  if [[ "$(printenv DOTFILES_SKIP_PACKAGES || true)" == true ]]; then
    echo "  Skipping language-server installation (DOTFILES_SKIP_PACKAGES=true)"
    return
  fi
  if [[ "$dry_run" == true ]]; then
    echo "  Would install Neovim language servers in $data_root/npm"
    return
  fi
  command -v npm >/dev/null 2>&1 || die "npm is required for Neovim language servers"
  mkdir -p "$data_root/npm"
  npm install --prefix "$data_root/npm" \
    typescript@5.9.3 typescript-language-server vscode-langservers-extracted \
    @tailwindcss/language-server
}

check_nvim() {
  selected nvim || return 0
  [[ "$dry_run" == true ]] && { echo "  Would verify Neovim 0.12+"; return; }
  command -v nvim >/dev/null 2>&1 || die "Neovim 0.12+ was not found"
  local version major minor
  version=$(nvim --version | head -1 | sed -n 's/.*v\([0-9]*\.[0-9]*\).*/\1/p')
  major=${version%%.*}; minor=${version#*.}
  [[ -n "$version" && ( "$major" -gt 0 || "$minor" -ge 12 ) ]] || die "Neovim 0.12+ is required (found ${version:-unknown})"
}

copy_file() {
  local source="$1" dest="$2" backup="$3"
  if [[ -f "$dest" ]]; then
    mkdir -p "$(dirname "$backup")"
    cp -p "$dest" "$backup"
  fi
  mkdir -p "$(dirname "$dest")"
  cp -p "$source" "$dest"
}

install_tmux_plugins() {
  selected tmux || return 0
  local plugin_root="$config_root/tmux/plugins"
  local tpm_dir="$plugin_root/tpm"
  local easy_motion_dir="$plugin_root/tmux-easy-motion"
  if [[ "$(printenv DOTFILES_SKIP_TMUX_PLUGINS || true)" == true ]]; then
    echo "  Skipping tmux plugin installation (DOTFILES_SKIP_TMUX_PLUGINS=true)"
    return
  fi
  if [[ "$dry_run" == true ]]; then
    echo "  Would install tmux plugins into $plugin_root"
    return
  fi
  command -v git >/dev/null 2>&1 || die "git is required to install tmux plugins"
  mkdir -p "$plugin_root"
  if [[ ! -x "$tpm_dir/tpm" ]]; then
    [[ ! -e "$tpm_dir" ]] || die "TPM path exists but is not a valid TPM checkout: $tpm_dir"
    git clone --depth 1 https://github.com/tmux-plugins/tpm.git "$tpm_dir"
  fi
  if [[ ! -f "$easy_motion_dir/easy_motion.tmux" ]]; then
    [[ ! -e "$easy_motion_dir" ]] || die "EasyMotion path exists but is not a valid checkout: $easy_motion_dir"
    git clone --depth 1 https://github.com/IngoMeyer441/tmux-easy-motion.git "$easy_motion_dir"
  fi
  [[ -f "$easy_motion_dir/easy_motion.tmux" ]] || die "tmux-easy-motion installation failed"
  echo "  tmux plugins installed (TPM, tmux-easy-motion)"
}

install_nvim() {
  selected nvim || return 0
  local dest backup file
  dest="$config_root/nvim"
  backup="$config_root/nvim.backup.$(date +%s)"
  if [[ -d "$dest" && ! -f "$nvim_marker" ]]; then
    confirm "Existing Neovim config found. Back up and install managed files?" || { echo "  Neovim installation cancelled."; return; }
  fi
  if [[ "$dry_run" == true ]]; then echo "  Would install Neovim into $dest"; return; fi
  mkdir -p "$dest"
  for file in "${nvim_files[@]}"; do copy_file "$repo_dir/nvim/$file" "$dest/$file" "$backup/$file"; done
  printf 'dotfiles manages the Neovim files listed in install.\n' > "$nvim_marker"
  echo "  Neovim installed (backup: $backup)"
  nvim --headless +qa
}

install_tmux() {
  selected tmux || return 0
  local dest backup file
  dest="$config_root/tmux"
  backup="$config_root/tmux.backup.$(date +%s)"
  if [[ -f "$dest/tmux.conf" && ! -f "$tmux_marker" ]]; then
    confirm "Existing tmux config found. Back up and replace it?" || { echo "  tmux installation cancelled."; return; }
  fi
  if [[ "$dry_run" == true ]]; then echo "  Would install tmux into $dest"; return; fi
  mkdir -p "$dest"
  for file in "${tmux_files[@]}"; do
    copy_file "$repo_dir/tmux/$file" "$dest/$file" "$backup/$file"
  done
  printf 'dotfiles manages tmux.conf.\n' > "$tmux_marker"
  echo "  tmux installed (backup: $backup)"
}

install_btop() {
  (selected tmux || selected btop) || return 0
  [[ -f "$repo_dir/btop/btop.conf" ]] || die "Invalid btop component in checkout"
  local backup="$config_root/btop.backup.$(date +%s)"
  if [[ "$dry_run" == true ]]; then echo "  Would install btop into $config_root/btop"; return; fi
  mkdir -p "$config_root/btop"
  for file in "${btop_files[@]}"; do
    copy_file "$repo_dir/btop/$file" "$config_root/btop/$file" "$backup/$file"
  done
  printf 'dotfiles manages btop.conf.\n' > "$config_root/btop/.dotfiles-btop-managed"
  echo "  btop installed (backup: $backup)"
}

uninstall_component() {
  local kind="$1" dest backup file found=false
  if [[ "$kind" == nvim ]]; then dest="$config_root/nvim"; backup="$config_root/nvim.uninstall-backup.$(date +%s)"; [[ -f "$nvim_marker" ]] || { echo "  Neovim is not managed; nothing removed."; return; }; fi
  if [[ "$kind" == tmux ]]; then dest="$config_root/tmux"; backup="$config_root/tmux.uninstall-backup.$(date +%s)"; [[ -f "$tmux_marker" ]] || { echo "  tmux is not managed; nothing removed."; return; }; fi
  if [[ "$kind" == btop ]]; then
    local btop_marker="$config_root/btop/.dotfiles-btop-managed"
    [[ -f "$btop_marker" ]] || { echo "  btop is not managed; nothing removed."; return; }
    confirm "Remove managed btop configuration?" || return
    if [[ "$dry_run" == true ]]; then echo "  Would remove managed btop configuration from $config_root/btop"; return; fi
    local btop_backup="$config_root/btop.uninstall-backup.$(date +%s)"
    for file in "${btop_files[@]}"; do
      if [[ -f "$config_root/btop/$file" ]]; then mkdir -p "$btop_backup"; cp -p "$config_root/btop/$file" "$btop_backup/$file"; rm -f "$config_root/btop/$file"; fi
    done
    rm -f "$btop_marker"
    rmdir "$config_root/btop" 2>/dev/null || true
    echo "  Removed btop configuration (backup: $btop_backup)"
    return
  fi
  if [[ "$kind" == zsh ]]; then
    [[ -f "$zsh_marker" ]] || { echo "  zsh is not managed; nothing removed."; return; }
    confirm "Remove managed zsh configuration?" || return
    if [[ "$dry_run" == true ]]; then echo "  Would remove managed zsh configuration from $config_root/zsh and ~/.zshrc"; return; fi
    local zshrc_backup="$HOME/.zshrc.uninstall-backup.$(date +%s)"
    if [[ -f "$HOME/.zshrc" ]]; then
      cp -p "$HOME/.zshrc" "$zshrc_backup"
      awk '
        /^# >>> dotfiles zsh >>>$/ { skip=1; next }
        /^# <<< dotfiles zsh <<<$/ { skip=0; next }
        !skip { print }
      ' "$HOME/.zshrc" > "$HOME/.zshrc.dotfiles.tmp"
      mv "$HOME/.zshrc.dotfiles.tmp" "$HOME/.zshrc"
    fi
    rm -f "$config_root/zsh/path-navigation.zsh" "$zsh_marker"
    rmdir "$config_root/zsh" 2>/dev/null || true
    echo "  Removed zsh configuration (backup: $zshrc_backup)"
    return
  fi
  if [[ "$kind" == mpv ]]; then
    [[ -f "$mpv_marker" ]] || { echo "  mpv is not managed; nothing removed."; return; }
    echo "  mpv uninstall is manual because mpv.conf may contain merged user settings. Review the mpv backup before removing files."
    return
  fi
  if [[ "$kind" == course ]]; then
    [[ -f "$course_marker" ]] || { echo "  course is not managed; nothing removed."; return; }
    local course_file="$HOME/.local/bin/course" course_backup="$HOME/.local/bin/course.uninstall-backup.$(date +%s)"
    confirm "Remove managed course launcher?" || return
    if [[ "$dry_run" == true ]]; then echo "  Would remove $course_file"; return; fi
    if [[ -f "$course_file" ]]; then cp -p "$course_file" "$course_backup"; rm -f "$course_file"; fi
    rm -f "$course_marker"
    echo "  Removed course launcher (backup: $course_backup)"
    return
  fi
  confirm "Remove managed $kind files?" || return
  if [[ "$dry_run" == true ]]; then echo "  Would remove managed $kind files from $dest"; return; fi
  if [[ "$kind" == nvim ]]; then
    for file in "${nvim_files[@]}"; do if [[ -f "$dest/$file" ]]; then mkdir -p "$(dirname "$backup/$file")"; cp -p "$dest/$file" "$backup/$file"; rm -f "$dest/$file"; found=true; fi; done
    rm -f "$nvim_marker"
  else
    for file in "${tmux_files[@]}"; do
      if [[ -f "$dest/$file" ]]; then mkdir -p "$backup"; cp -p "$dest/$file" "$backup/$file"; rm -f "$dest/$file"; found=true; fi
    done
    rm -f "$tmux_marker"
    for file in "${btop_files[@]}"; do
      if [[ -f "$config_root/btop/$file" ]]; then
        mkdir -p "$backup/btop"
        cp -p "$config_root/btop/$file" "$backup/btop/$file"
        rm -f "$config_root/btop/$file"
        found=true
      fi
    done
    rm -f "$config_root/btop/.dotfiles-btop-managed"
    rmdir "$config_root/btop" 2>/dev/null || true
  fi
  [[ "$found" == true ]] && echo "  Removed managed $kind files (backup: $backup)"
  rmdir "$dest" 2>/dev/null || true
}

update_checkout() {
  [[ "$dry_run" == true ]] && { echo "  Would pull latest dotfiles checkout in $repo_dir"; return; }
  [[ -d "$repo_dir/.git" ]] || die "$repo_dir is not a Git checkout"
  git -C "$repo_dir" pull --ff-only
}

parse_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      install|update|uninstall) action="$arg" ;;
      zsh|tmux|btop|nvim|mpv|course) [[ "$component" == all ]] || die "Choose only one component"; component="$arg" ;;
      -y|--yes) yes=true ;;
      --dry-run) dry_run=true ;;
      -h|--help) usage; exit 0 ;;
      '') ;;
      *) die "Unknown argument '$arg'. Run with --help." ;;
    esac
  done
}

parse_args "$@"
[[ -d "$repo_dir/nvim" && -f "$repo_dir/tmux/tmux.conf" ]] || die "Invalid dotfiles checkout: $repo_dir"
os=$(uname -s)
[[ "$os" == Darwin || "$os" == Linux ]] || die "Unsupported OS: $os"
if [[ "$action" == update ]]; then update_checkout; fi
if [[ "$action" == uninstall ]]; then selected zsh && uninstall_component zsh; selected nvim && uninstall_component nvim; selected tmux && uninstall_component tmux; selected btop && uninstall_component btop; selected mpv && uninstall_component mpv; selected course && uninstall_component course; exit 0; fi
install_packages "$os"
install_zsh
check_nvim
install_tmux
install_btop
install_tmux_plugins
install_nvim
install_language_servers
install_mpv
install_course
echo "dotfiles $action complete."
